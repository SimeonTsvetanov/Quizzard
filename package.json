{
  "name": "quizzard",
  "private": true,
  "type": "module",
  "version": "0.25.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "dev": "pnpm generate && pnpm -F \"./miniapps/*/packages/core\" -F \"./miniapps/*/packages/player\" build && pnpm -F app dev",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "build": "pnpm generate && pnpm -r build",
    "verify": "pnpm generate && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check && pnpm -r build && pnpm size",
    "size": "node scripts/size-check.ts",
    "docs:check": "node scripts/check-docs.ts",
    "docs:images": "pnpm build && playwright test -c playwright.docs.config.ts --pass-with-no-tests",
    "preview": "pnpm -F app preview",
    "e2e": "playwright test",
    "screenshots": "pnpm build && playwright test -c playwright.screenshots.config.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.11.0",
    "globals": "^17.0.0",
    "jsdom": "31.0.1",
    "marked": "^18.0.0",
    "postcss": "8.5.33",
    "prettier": "^3.9.0",
    "sharp": "^0.35.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.1.0"
  }
}
